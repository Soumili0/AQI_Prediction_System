# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
# SECRET_KEY is a random string used by Flask to sign session cookies.
# Generate your own by running: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Database — replace 'password' with your actual MySQL root password.
# DATABASE_URL uses the format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DB_NAME
# NOTE: Special characters in the password must be URL-encoded:
#   * -> %2A, # -> %23, @ -> %40, ! -> %21, etc.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/aqi_prediction_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aqi_prediction_db
DB_USER=root
# DB_PASSWORD must match the password in DATABASE_URL above.
DB_PASSWORD=password

# JWT Authentication
# JWT_SECRET_KEY is a random string used to sign JWT auth tokens.
# Generate your own by running: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
# Access token expiry in seconds (3600 = 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600
# Refresh token expiry in seconds (2592000 = 30 days)
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Email (for password reset) — optional, only needed if you use forgot/reset password.
# Use Gmail App Password, NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@aqiprediction.com

# OpenAQ API — optional, used to fetch public air quality sensor data.
# Get a free API key at: https://explore.openaq.org/register
OPENAQ_API_KEY=your-openaq-api-key
OPENAQ_BASE_URL=https://api.openaq.io/v2

# ML Model Paths — these are generated by running ml/scripts/train_models.py.
MODEL_PATH=ml/models/aqi_model.pkl
SCALER_PATH=ml/models/scaler.pkl
FEATURE_NAMES_PATH=ml/models/feature_names.json

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting — controls how many requests a user can make.
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Frontend URL (used in password reset email links)
FRONTEND_URL=http://localhost:5173
