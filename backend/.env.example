# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=mysql+mysqlclient://root:password@localhost:3306/aqi_prediction_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=aqi_prediction_db
DB_USER=root
DB_PASSWORD=password

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Email (for password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@aqiprediction.com

# OpenAQ API
OPENAQ_API_KEY=your-openaq-api-key
OPENAQ_BASE_URL=https://api.openaq.io/v2

# ML Model Paths
MODEL_PATH=ml/models/aqi_model.pkl
SCALER_PATH=ml/models/scaler.pkl
FEATURE_NAMES_PATH=ml/models/feature_names.json

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URL=memory://

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Frontend URL (for password reset links)
FRONTEND_URL=http://localhost:5173
