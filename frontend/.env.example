# Vite environment variables (must start with VITE_ to be exposed to browser)

# Backend API base URL
# Development: leave empty to use Vite proxy (proxies /api → localhost:5000)
# Production:  set to your deployed backend URL
VITE_API_URL=

# App metadata
VITE_APP_NAME="AQI Prediction System"
VITE_APP_VERSION="1.0.0"
